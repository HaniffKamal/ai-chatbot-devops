# ==============================================================================
# Production Environment Configuration: AWS EC2 (Strict Rule 1.1 & 4.1)
# ==============================================================================
# Rendered dynamically by Ansible Jinja2 Template (templates/.env.j2)
# File Permissions: 0600 (Restricted strictly to the 'ubuntu' user on EC2)
# ==============================================================================

ENVIRONMENT=production

# Dual-Engine Inference: Use Cloud Groq API as primary on CPU-only AWS EC2
LLM_PROVIDER=groq
GROQ_API_KEY={{ groq_api_key }}
GROQ_MODEL={{ groq_model | default('openai/gpt-oss-20b') }}

# Local Ollama is intentionally disabled in production to preserve 100% CPU & 5GB RAM
OLLAMA_HOST=disabled
DEFAULT_MODEL=disabled
OLLAMA_TIMEOUT=60.0

# Security: CORS and Host Restriction
ALLOWED_ORIGINS={{ allowed_origins | default('http://localhost,http://localhost:80,https://haniffkamal.my') }}
