# ========================================================
# Environment Configuration (Ignored by Git)
# ========================================================

ENVIRONMENT=development

# Active Docker Compose Profiles ('local' enables Ollama container on workstations)
COMPOSE_PROFILES=local

# Primary LLM Provider: 'ollama' (local GPU) or 'groq' (cloud API on CPU host)
LLM_PROVIDER=ollama

# Local Ollama Inference Configuration
OLLAMA_HOST=http://ollama:11434
DEFAULT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=60.0

# Cloud Groq Inference Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Security & Networking
ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://haniffkamal.my,https://chatbot.haniffkamal.my
